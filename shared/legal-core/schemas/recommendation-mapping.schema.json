{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neolex.local/schemas/legal-core/recommendation-mapping.schema.json",
  "title": "Схема маппинга следующего продукта Lexy Release 0",
  "description": "JSON Schema для черновой детерминированной конфигурации рекомендации. Схема проверяет структуру, но не подтверждает юридическую или коммерческую корректность содержания.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "mappingId",
    "mappingMeta",
    "governance",
    "sourceCatalogs",
    "inputContract",
    "productCatalog",
    "selectionContract",
    "riskRouting",
    "creditEligibility",
    "deterministicGuarantees"
  ],
  "$defs": {
    "productCode": {
      "enum": [
        "start_product",
        "safe_sales",
        "rights_and_ip",
        "data_and_infrastructure",
        "enterprise_readiness",
        "expert_review"
      ]
    },
    "standardProductCode": {
      "enum": [
        "start_product",
        "safe_sales",
        "rights_and_ip",
        "data_and_infrastructure",
        "enterprise_readiness"
      ]
    },
    "status": {
      "const": "draft_pending_legal_approval"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "version",
        "effectiveFrom",
        "effectiveTo",
        "status",
        "updatedBy",
        "updatedAt",
        "sourceCommit",
        "legalReviewNotice"
      ],
      "properties": {
        "releaseId": {
          "const": "lexy-r0-2026-09-12"
        },
        "version": {
          "const": "1.0.0-draft.1"
        },
        "effectiveFrom": {
          "type": "null"
        },
        "effectiveTo": {
          "type": "null"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "updatedBy": {
          "const": "Manus AI"
        },
        "updatedAt": {
          "const": "2026-09-12T18:40:24Z"
        },
        "sourceCommit": {
          "const": "78e2f89e99340a403ce389eada223da6bf336676"
        },
        "legalReviewNotice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normativeRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NORM-[A-Z0-9-]+$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DESIGN-R0-REC-[0-9]{3}$"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OQ-R0-REC-[0-9]{3}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "status"
      ],
      "properties": {
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "1.0.0-draft.1"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "oneOf": [
        {
          "required": [
            "catalogId"
          ]
        },
        {
          "required": [
            "policyId"
          ]
        }
      ]
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "type",
        "meaning"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalizedSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentCode",
        "sourceOptionRefs"
      ],
      "properties": {
        "segmentCode": {
          "enum": [
            "early_saas_b2b",
            "b2c_sales",
            "ip_development",
            "data_intensive",
            "investment_enterprise",
            "general"
          ]
        },
        "sourceOptionRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^b(1[0-4]|[1-9])_q[1-9][0-9]*:[a-z0-9_]+$"
          }
        }
      }
    },
    "normalizedGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalCode",
        "sourceOptionRefs"
      ],
      "properties": {
        "goalCode": {
          "enum": [
            "launch",
            "ip",
            "safe_sales",
            "data",
            "partnership",
            "investment_enterprise",
            "expert_review",
            "general"
          ]
        },
        "sourceOptionRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^b(1[0-4]|[1-9])_q[1-9][0-9]*:[a-z0-9_]+$"
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productCode",
        "displayName",
        "productKind",
        "linkedTariffId",
        "availability"
      ],
      "properties": {
        "productCode": {
          "$ref": "#/$defs/productCode"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "productKind": {
          "enum": [
            "пакет документов и исправлений",
            "пакет документов и сопровождения",
            "заявка на экспертный разбор"
          ]
        },
        "linkedTariffId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": "lexy-expert-report-review-request"
            }
          ]
        },
        "availability": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "field": {
          "enum": [
            "integrityStatus",
            "manualReviewRequiredRiskIds",
            "effectiveSeveritiesByRiskId",
            "appliedCriticalOverrideRiskIds",
            "escalationRequired",
            "normalizedGoalCodes",
            "activeRiskIds"
          ]
        },
        "operator": {
          "enum": [
            "equals",
            "non_empty",
            "contains_value",
            "contains",
            "contains_unmapped_or_disallowed_risk"
          ]
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        }
      }
    },
    "stopFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopFactorId",
        "priority",
        "condition",
        "resultProductCode",
        "reason"
      ],
      "properties": {
        "stopFactorId": {
          "type": "string",
          "pattern": "^STOP-REC-[0-9]{3}$"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "resultProductCode": {
          "const": "expert_review"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "segmentBoost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "segmentCode",
        "productCode",
        "points"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/scoreRuleId"
        },
        "segmentCode": {
          "enum": [
            "early_saas_b2b",
            "b2c_sales",
            "ip_development",
            "data_intensive",
            "investment_enterprise",
            "general"
          ]
        },
        "productCode": {
          "$ref": "#/$defs/standardProductCode"
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "goalBoost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "goalCode",
        "productCode",
        "points"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/scoreRuleId"
        },
        "goalCode": {
          "enum": [
            "launch",
            "ip",
            "safe_sales",
            "data",
            "partnership",
            "investment_enterprise",
            "general"
          ]
        },
        "productCode": {
          "$ref": "#/$defs/standardProductCode"
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "riskRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskId",
        "primaryProductCode",
        "rationale"
      ],
      "properties": {
        "riskId": {
          "type": "string",
          "pattern": "^LEXR0-RISK-[0-9]{3}$"
        },
        "primaryProductCode": {
          "$ref": "#/$defs/productCode"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "creditEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productCode",
        "eligible",
        "status"
      ],
      "properties": {
        "productCode": {
          "$ref": "#/$defs/productCode"
        },
        "eligible": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "scoreRuleId": {
      "type": "string",
      "pattern": "^SCORE-(SEGMENT|GOAL)-[0-9]{3}$"
    }
  },
  "properties": {
    "$schema": {
      "const": "./schemas/recommendation-mapping.schema.json"
    },
    "mappingId": {
      "const": "recommendation_mapping_v1"
    },
    "mappingMeta": {
      "$ref": "#/$defs/meta"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normativeRequirements",
        "projectDecisions",
        "openQuestions"
      ],
      "properties": {
        "normativeRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/normativeRequirement"
          }
        },
        "projectDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/projectDecision"
          }
        },
        "openQuestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/openQuestion"
          }
        }
      }
    },
    "sourceCatalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskCatalog",
        "tariffCatalog",
        "creditPolicy"
      ],
      "properties": {
        "riskCatalog": {
          "allOf": [
            {
              "$ref": "#/$defs/sourceReference"
            },
            {
              "properties": {
                "catalogId": {
                  "const": "risk_catalog_v1"
                },
                "path": {
                  "const": "./risk_catalog_v1.json"
                }
              }
            }
          ]
        },
        "tariffCatalog": {
          "allOf": [
            {
              "$ref": "#/$defs/sourceReference"
            },
            {
              "properties": {
                "catalogId": {
                  "const": "tariffs_v1"
                },
                "path": {
                  "const": "../billing/tariffs_v1.json"
                }
              }
            }
          ]
        },
        "creditPolicy": {
          "allOf": [
            {
              "$ref": "#/$defs/sourceReference"
            },
            {
              "properties": {
                "policyId": {
                  "const": "base-diagnostic-credit-6900-rub-v1"
                },
                "path": {
                  "const": "../billing/credit_policy_v1.json"
                }
              }
            }
          ]
        }
      }
    },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalSource",
        "requiredInputFields",
        "normalizedSegmentCatalog",
        "normalizedGoalCatalog"
      ],
      "properties": {
        "canonicalSource": {
          "type": "string",
          "minLength": 1
        },
        "requiredInputFields": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inputField"
          }
        },
        "normalizedSegmentCatalog": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalizedSegment"
          }
        },
        "normalizedGoalCatalog": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalizedGoal"
          }
        }
      }
    },
    "productCatalog": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/product"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "productCode": {
                "const": "start_product"
              }
            },
            "required": [
              "productCode"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "productCode": {
                "const": "safe_sales"
              }
            },
            "required": [
              "productCode"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "productCode": {
                "const": "rights_and_ip"
              }
            },
            "required": [
              "productCode"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "productCode": {
                "const": "data_and_infrastructure"
              }
            },
            "required": [
              "productCode"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "productCode": {
                "const": "enterprise_readiness"
              }
            },
            "required": [
              "productCode"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "productCode": {
                "const": "expert_review"
              }
            },
            "required": [
              "productCode"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "selectionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultCardinality",
        "resultField",
        "languageModelParticipation",
        "standardCandidateProductCodes",
        "failSafeProductCode",
        "fallbackProductCode",
        "fallbackRuleId",
        "fallbackCondition",
        "executionOrder",
        "stopFactors",
        "severityWeights",
        "segmentBoosts",
        "goalBoosts",
        "tieBreakOrder"
      ],
      "properties": {
        "resultCardinality": {
          "const": 1
        },
        "resultField": {
          "const": "productCode"
        },
        "languageModelParticipation": {
          "const": "forbidden"
        },
        "standardCandidateProductCodes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/standardProductCode"
          }
        },
        "failSafeProductCode": {
          "const": "expert_review"
        },
        "fallbackProductCode": {
          "const": "start_product"
        },
        "fallbackRuleId": {
          "const": "FALLBACK-REC-001"
        },
        "executionOrder": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stopFactors": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stopFactor"
          }
        },
        "severityWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "critical": {
              "const": 100
            },
            "high": {
              "const": 40
            },
            "medium": {
              "const": 20
            },
            "low": {
              "const": 10
            }
          }
        },
        "segmentBoosts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/segmentBoost"
          }
        },
        "goalBoosts": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/goalBoost"
          }
        },
        "tieBreakOrder": {
          "type": "array",
          "prefixItems": [
            {
              "const": "data_and_infrastructure"
            },
            {
              "const": "rights_and_ip"
            },
            {
              "const": "safe_sales"
            },
            {
              "const": "enterprise_readiness"
            },
            {
              "const": "start_product"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "fallbackCondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluationStage",
            "operator"
          ],
          "properties": {
            "evaluationStage": {
              "const": "after_scoring"
            },
            "operator": {
              "const": "no_positive_candidates"
            }
          },
          "description": "FALLBACK-REC-001 is eligible only after score aggregation finds no positive candidate."
        }
      }
    },
    "riskRouting": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/riskRoute"
      }
    },
    "creditEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "sourceTariffId",
        "currency",
        "creditAmountRub",
        "eligibilityKey",
        "textMatchingForbidden",
        "entries",
        "releaseRestriction"
      ],
      "properties": {
        "policyId": {
          "const": "base-diagnostic-credit-6900-rub-v1"
        },
        "sourceTariffId": {
          "const": "lexy-advanced-diagnostic"
        },
        "currency": {
          "const": "RUB"
        },
        "creditAmountRub": {
          "const": 6900
        },
        "eligibilityKey": {
          "const": "productCode"
        },
        "textMatchingForbidden": {
          "const": true
        },
        "entries": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/creditEntry"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "productCode": {
                    "const": "start_product"
                  },
                  "eligible": {
                    "const": true
                  }
                },
                "required": [
                  "productCode",
                  "eligible"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "productCode": {
                    "const": "safe_sales"
                  },
                  "eligible": {
                    "const": true
                  }
                },
                "required": [
                  "productCode",
                  "eligible"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "productCode": {
                    "const": "rights_and_ip"
                  },
                  "eligible": {
                    "const": true
                  }
                },
                "required": [
                  "productCode",
                  "eligible"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "productCode": {
                    "const": "data_and_infrastructure"
                  },
                  "eligible": {
                    "const": true
                  }
                },
                "required": [
                  "productCode",
                  "eligible"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "productCode": {
                    "const": "enterprise_readiness"
                  },
                  "eligible": {
                    "const": true
                  }
                },
                "required": [
                  "productCode",
                  "eligible"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "productCode": {
                    "const": "expert_review"
                  },
                  "eligible": {
                    "const": false
                  }
                },
                "required": [
                  "productCode",
                  "eligible"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "releaseRestriction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deterministicGuarantees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactlyOneProduct",
        "criticalAndManualReviewPrecedeScoring",
        "investmentAndEnterpriseCannotOverrideStopFactors",
        "fixedTieBreak",
        "fixedFallback",
        "creditUsesProductCodeOnly",
        "clientDisplayTextAffectsDecision",
        "languageModelAffectsDecision"
      ],
      "properties": {
        "exactlyOneProduct": {
          "const": true
        },
        "criticalAndManualReviewPrecedeScoring": {
          "const": true
        },
        "investmentAndEnterpriseCannotOverrideStopFactors": {
          "const": true
        },
        "fixedTieBreak": {
          "const": true
        },
