    "consistencyRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consistencyRule"
      }
    },
    "followUpRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/followUpRule"
      }
    },
    "escalationRules": {
      "type": "array",
      "minItems": 1,
